# Immich server origin. A trailing /api is accepted.
IMMICH_URL=https://photos.example.com
# API key from Immich → Account Settings → API Keys.
# Needs at least: asset.read, asset.view, person.read, album.read
IMMICH_API_KEY=
# Optional: origin used for links handed back to the user, when the server
# reaches Immich on a private address (e.g. http://immich-server:2283).
# IMMICH_PUBLIC_URL=https://photos.example.com
# Zone that bare dates ("2024-06") are read in. Default UTC.
TZ=America/Chicago
# Optional: per-request timeout in milliseconds. Default 30000.
# IMMICH_TIMEOUT_MS=30000

# Transport. The container image defaults to http on 0.0.0.0:3000.
# IMMICH_MCP_TRANSPORT=stdio
# IMMICH_MCP_HTTP_HOST=127.0.0.1
# IMMICH_MCP_HTTP_PORT=3000
# IMMICH_MCP_HTTP_ALLOWED_ORIGINS=
